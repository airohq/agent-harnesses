#!/bin/sh
# A git credential helper for sandboxes behind Substrate's egress gateway. The
# gateway replaces the Authorization header of a request to a host that has a
# credential, but never adds one, so git must send something to replace. This
# helper answers with an inert placeholder. Git asks for it only after a host
# answers 401, so anonymous requests, such as cloning a public repository,
# carry no Authorization header at all. The real credential never enters the
# sandbox (airohq/agentic-sdlc#107).
cat >/dev/null
[ "$1" = get ] || exit 0
echo username=x-access-token
echo password=placeholder
